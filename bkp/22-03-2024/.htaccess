RewriteRule ^uploadfilesissue/([^/]+)/([^/]+)$ upload_process_issue.php?id=$1&issue_id=$2 [NC,L]


RewriteRule ^sendinstruction/([^/]+)/([^/]+)$ send_instructions.php?id=$1 [NC,L]
RewriteRule ^startwork/([^/]+)/([^/]+)$ start_work.php?aid=$1&tid=$2 [NC,L]
