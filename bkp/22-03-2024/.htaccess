Options +FollowSymLinks -MultiViews
DirectoryIndex index.php
DirectoryIndex index.html
Options -Indexes
RewriteEngine on
# Exclude CSS and JS files from rewriting
RewriteCond %{REQUEST_URI} !\.(css|js)$


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
# Disable Directory Browsing
Options All -Indexes



RewriteRule ^index$ index.php [NC,L]
RewriteRule ^logout$ logout.php [NC,L]
RewriteRule ^changepassword change-password.php [NC,L]
RewriteRule ^settings settings.php [NC,L]

RewriteRule ^addcustomer$ add-customer.php [NC,L]
RewriteRule ^addjournal$ add-journal.php [NC,L]
RewriteRule ^addjournaltype$ add-journal-type.php [NC,L]
RewriteRule ^addfolder$ add-folder.php [NC,L]
RewriteRule ^adddepartment$ add-department.php [NC,L]
RewriteRule ^addmovefiles$ add-move-files.php [NC,L]
RewriteRule ^addworkflow$ add-workflow.php [NC,L]
RewriteRule ^addchecklist$ add-checklist.php [NC,L]
RewriteRule ^addemails$ add-emails.php [NC,L]
RewriteRule ^addclientfeedback$ add-client-feedback.php [NC,L]
RewriteRule ^addarticletype$ add-article-type.php [NC,L]
RewriteRule ^addschedulemaildetails$ add_schedule_mail_details.php [NC,L]
RewriteRule ^addarchiveconfig$ add_archive_config.php [NC,L]
RewriteRule ^addshiftsettings$ add-shift-settings.php [NC,L]
RewriteRule ^addusers$ add-users.php [NC,L]
RewriteRule ^addrole$ add-role.php [NC,L]

RewriteRule ^add-article$ add-article.php [NC,L]



RewriteRule ^edit-customer/([^/]*)$ edit-customer.php?id=$1 [NC,L]
RewriteRule ^edit-journal/([^/]*)$ edit-journal.php?id=$1 [NC,L]
RewriteRule ^edit-article/([^/]*)$ edit_article.php?aid=$1 [NC,L]
