RewriteRule ^edit-archive-config/([^/]*)$ edit-archive-config.php?id=$1 [NC,L]
RewriteRule ^edit-shift-settings/([^/]*)$ edit-shift-settings.php?id=$1 [NC,L]
RewriteRule ^edit-users/([^/]*)$ edit-users.php?id=$1 [NC,L]
RewriteRule ^edit-role/([^/]*)$ edit-role.php?id=$1 [NC,L]


RewriteRule ^articles$ view_articles.php [NC,L]
RewriteRule ^graphicarticles$ view_graphic_articles.php [NC,L]
RewriteRule ^customers$ view_customers.php [NC,L]
